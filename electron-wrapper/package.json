{
  "name": "hermes-ceo-console-desktop",
  "version": "0.1.0-alpha.25",
  "private": true,
  "description": "Desktop wrapper and setup launcher for Hermes WebUI on localhost:8788",
  "main": "main.js",
  "author": "FMG",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test-desktop-menu.js",
    "build:mac": "electron-builder --mac dmg",
    "build:win": "electron-builder --win nsis",
    "dist": "electron-builder -mwl"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fmg.hermes-ceo-console",
    "productName": "Hermes CEO Console",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "setup.js",
      "logs.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "installer",
        "filter": [
          "install-macos.sh",
          "install-windows.ps1",
          "scripts/**",
          "templates/**",
          "profiles/**",
          "installer.manifest.json"
        ]
      }
    ],
    "afterSign": "scripts/notarize.js",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false,
      "signingHashAlgorithms": [
        "sha256"
      ],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
