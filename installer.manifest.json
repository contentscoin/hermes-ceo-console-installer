{
  "productName": "Hermes CEO Console",
  "version": "0.1.0-alpha.27",
  "appId": "com.fmg.hermes-ceo-console",
  "defaultPort": 8788,
  "primaryRepoUrl": "https://github.com/contentscoin/hermes-for-web.git",
  "fallbackRepoUrl": "https://github.com/contentscoin/hermes-for-web.git",
  "webuiRepoRef": "main",
  "expectedWebUICommit": "e3e593dc2dc526dedcd8fa0b66ed13f858d65b09",
  "installDir": "~/.hermes/webui/workspace/hermes-for-web",
  "homepage": "https://github.com/contentscoin/hermes-ceo-console-installer",
  "secretsIncluded": false,
  "integrations": {
    "telegram": {
      "mode": "user-token",
      "autoSend": false
    },
    "paperclip": {
      "mode": "local-fmg-source-install",
      "autoReflect": false,
      "installDefault": true,
      "repoUrl": "https://github.com/paperclipai/paperclip.git",
      "repoRef": "master",
      "expectedCommit": "9aea3e3d35fe47a745857b91c392da5b3fc0ae17",
      "webUrl": "http://127.0.0.1:3100"
    },
    "paperclipWorkflowControl": {
      "mode": "local-script",
      "default": "read-only",
      "mutationsRequireConfirmation": true,
      "issueWorkflowDagDiagnostics": true
    },
    "opencrab": {
      "mode": "user-config",
      "autoIngest": false,
      "endpointRedacted": true
    },
    "codex": {
      "mode": "oauth-device-login",
      "silentLogin": false
    },
    "neo4j": {
      "mode": "optional-local-or-external",
      "installDefault": false,
      "autoApply": false,
      "writeEnabledByDefault": false,
      "uriEnv": "NEO4J_URI",
      "userEnv": "NEO4J_USER",
      "passwordEnv": "NEO4J_PASSWORD",
      "databaseEnv": "NEO4J_DATABASE"
    }
  },
  "paperclipRepoUrl": "https://github.com/paperclipai/paperclip.git",
  "paperclipRepoRef": "master",
  "expectedPaperclipCommit": "9aea3e3d35fe47a745857b91c392da5b3fc0ae17",
  "paperclipInstallDir": "~/.hermes/webui/workspace/paperclip",
  "paperclipPort": 3100,
  "expectedHermesAgentVersion": "v0.14.0",
  "expectedHermesAgentCommit": "81a4f280d24e2ab77e1a10196c0a601838716111",
  "hermesAgentRepoUrl": "https://github.com/NousResearch/hermes-agent.git"
}
