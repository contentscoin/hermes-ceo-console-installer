{
  "productName": "Hermes CEO Console",
  "version": "0.1.0-alpha.2",
  "appId": "com.fmg.hermes-ceo-console",
  "defaultPort": 8788,
  "primaryRepoUrl": "https://github.com/contentscoin/hermes-for-web.git",
  "fallbackRepoUrl": "https://github.com/contentscoin/hermes-for-web.git",
  "installDir": "~/.hermes/webui/workspace/hermes-for-web",
  "homepage": "https://github.com/contentscoin/hermes-ceo-console-installer",
  "secretsIncluded": false,
  "integrations": {
    "telegram": {"mode": "user-token", "autoSend": false},
    "paperclip": {"mode": "user-config", "autoReflect": false},
    "paperclipWorkflowControl": {"mode": "local-script", "default": "read-only", "mutationsRequireConfirmation": true, "issueWorkflowDagDiagnostics": true},
    "opencrab": {"mode": "user-config", "autoIngest": false, "endpointRedacted": true},
    "codex": {"mode": "oauth-device-login", "silentLogin": false}
  }
}
