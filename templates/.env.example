# Copy values into ~/.hermes/.env via the setup wizard.
# Never commit real secrets.

# Paperclip
# WebUI Paperclip tab embeds this URL. Default: http://127.0.0.1:3100
PAPERCLIP_WEB_URL=http://127.0.0.1:3100
PAPERCLIP_BASE_URL=
PAPERCLIP_DEFAULT_COMPANY=FMG
PAPERCLIP_API_TOKEN=***

# OpenCrab
# OpenCrab MCP endpoint is configured in ~/.hermes/config.yaml, not stored here.
# Treat endpoint URLs as secrets when they contain embedded keys.
OPENCRAB_MCP_URL=***

# Telegram / Hermes Gateway
TELEGRAM_BOT_TOKEN=***
TELEGRAM_ALLOWED_CHATS=

# Optional model/provider keys are managed by `hermes setup` / `hermes auth`.
# Codex CLI uses its own login store. Run: codex login
